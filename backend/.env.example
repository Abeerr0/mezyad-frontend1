DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mezyad
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# تم التعديل من عبير: استخدم حساب بريد فعلي ومفتاح عشوائي طويل ولا ترفع ملف .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
EMAIL_OTP_SECRET=
# تم التعديل من عبير: مفاتيح الاختبار فقط من لوحه ميسر والمبلغ بالهللات.
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_COMMITMENT_HALALAS=10000
