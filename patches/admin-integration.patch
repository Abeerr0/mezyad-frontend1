diff --git a/Frontend/src/features/admin/admin-access.js b/Frontend/src/features/admin/admin-access.js
new file mode 100644
index 0000000..ab959ae
--- /dev/null
+++ b/Frontend/src/features/admin/admin-access.js
@@ -0,0 +1,29 @@
+const blockedPages = new Set([
+  "create-listing",
+  "edit-listing",
+  "create-auction",
+  "listings",
+  "bid",
+  "commitment",
+  "payment",
+]);
+
+export function isAdminRole(role) {
+  return role === "ADMIN";
+}
+
+export function isAdminPageBlocked(role, page) {
+  return isAdminRole(role) && blockedPages.has(page);
+}
+
+export function canShowMarketplaceActions(role) {
+  return !isAdminRole(role);
+}
+
+export function canShowAuctionNavPage(role, page) {
+  return !isAdminRole(role) || (page !== "commitment" && page !== "bid");
+}
+
+export function canShowAccountSettings(role) {
+  return !isAdminRole(role);
+}
diff --git a/Frontend/src/features/admin/admin-navigation.js b/Frontend/src/features/admin/admin-navigation.js
new file mode 100644
index 0000000..43489d3
--- /dev/null
+++ b/Frontend/src/features/admin/admin-navigation.js
@@ -0,0 +1,18 @@
+import { isAdminRole } from "./admin-access.js";
+
+export const ADMIN_PAGE = "admin";
+export const ADMIN_PATH = "/" + ADMIN_PAGE;
+export const ADMIN_HREF = "#" + ADMIN_PATH;
+
+export const ADMIN_ACCOUNT_LINKS = [
+  [ADMIN_PAGE, "لوحة الإدارة", "shield"],
+  ["profile", "الملف الشخصي", "user"],
+];
+
+export function accountDestination(role, fallback) {
+  return isAdminRole(role) ? ADMIN_PATH : fallback;
+}
+
+export function accountBreadcrumbHref(role) {
+  return isAdminRole(role) ? "#/profile" : "#/activity";
+}
