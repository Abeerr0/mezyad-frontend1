VITE_API_URL=/api/v1

# Password recovery API paths, relative to VITE_API_URL. Enable only after backend implementation.
# Request: POST {email} -> {data:{}} (same response for registered/unregistered emails).
# Verify: POST {email,code} -> {data:{resetToken}}.
# Confirm: POST {resetToken,password} -> {data:{}}; token must expire and be single use.
VITE_RESET_REQUEST_PATH=
VITE_RESET_VERIFY_PATH=
VITE_RESET_CONFIRM_PATH=

# Email verification: request checks duplicates and stores a pending signup, not an active user.
# POST request {name,email,password} -> {data:{}}; resend accepts {email,resend:true}.
# POST complete {email,code} -> {data:{id}}. Backend validates expiry, attempts and single use.
VITE_SIGNUP_REQUEST_PATH=
VITE_SIGNUP_COMPLETE_PATH=
# Same-origin OAuth start URL. Backend must handle state, PKCE and callback/session.
VITE_GOOGLE_START_PATH=
