#  مثال يوضح إعدادات تشغيل الباك إند محليًا
# عنوان الاتصال بقاعدة البيانات اسم المستخدم وكلمة المرور هنا للتجربة المحلية
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mezyad
# رقم المنفذ الذي يستقبل عليه الباك إند الطلبات
PORT=3000
# عنوان الواجهة المسموح لها بقراءة ردود الباك إند من المتصفح
FRONTEND_ORIGIN=http://localhost:5173
# رابط بيئة البنك التجريبية نتركه فارغ لأن الربط مؤجل
BANK_SANDBOX_BASE_URL=
# معرف التطبيق عند مزود البنك نتركه فارغ حاليًا
BANK_SANDBOX_CLIENT_ID=
# المفتاح السري الخاص بربط البنك نتركه فارغ لان البنك لسا مؤجل
BANK_SANDBOX_CLIENT_SECRET=
# عنوان خادم ارسال الايميل
SMTP_HOST=smtp.gmail.com
# منفذ الاتصال المشفر
SMTP_PORT=465
# ايميل مزياد اللي يرسل رموز التحقق
SMTP_USER=mezyad1sa@gmail.com
# نتركها فاضيه وكلمة مرور التطبيق تنضاف في backend/.env عند كل وحده
SMTP_PASS= # كلمه السر للبريد هنا 
# اسم وايميل المرسل اللي يظهر للمستخدم
MAIL_FROM="Mezyad <mezyad1sa@gmail.com>"
#كلمه السر ماتنرفع للريبو هذي بس تكون في الجهاز محليه. 
# هذي النسخه مثال يتطبق على الملف المحلي اللي يتشغل بالجهاز هنا نحط المفتاح الخاص بميسر
MOYASAR_SECRET_KEY= # مفتاح ميسر السري 
#  تاكدو انه يكون عندكم  الشرط يكون مفعل true عشان البنك يتفعل 
REQUIRE_BANK_COMMITMENT=true
#هذي الاعدادات تتعدل في كلف env الخاص فيكم على الجهاز لوكالي ماتنرفع للريبو ممنوع 
#ممنوع مشاركه المفاتيح السريه مع اي احد ممنوع فقط انتو تحطوها بنفسكم هنا في الملف اللي على جهازكم 

